{
	"useTabs": false,
	"tabWidth": 4,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 160,
	"svelteBracketNewLine": true,
	"svelteStrictMode": false,
	"svelteAllowShorthand": true,
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte",
				"printWidth": 160
			}
		}
	]
}
